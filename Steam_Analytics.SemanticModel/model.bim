        "measures": [
          {
            "name": "Total Games",
            "description": "Tổng số lượng tựa game trên nền tảng Steam",
            "expression": "DISTINCTCOUNT(dim_games[appid])",
            "formatString": "#,##0",
            "displayFolder": "01. Market Overview",
            "lineageTag": "a44ad267-9bfd-4038-b936-42bd061c209a",
            "dataType": "int64",
            "modifiedTime": "2026-11-01T06:42:44.796667",
            "structureModifiedTime": "2026-11-01T06:42:44.766667"
          },
          {
            "name": "Total Free Games",
            "description": "Tổng số lượng game miễn phí",
            "expression": "CALCULATE([Total Games], dim_games[is_free] = 1)",
            "formatString": "#,##0",
            "displayFolder": "01. Market Overview",
            "lineageTag": "55c3f440-ebea-406d-b962-979746f1bfd8",
            "dataType": "int64",
            "modifiedTime": "2026-11-01T06:42:44.796667",
            "structureModifiedTime": "2026-11-01T06:42:44.766667"
          },
          {
            "name": "Total Paid Games",
            "description": "Tổng số lượng game trả phí",
            "expression": "CALCULATE([Total Games], dim_games[is_free] = 0)",
            "formatString": "#,##0",
            "displayFolder": "01. Market Overview",
            "lineageTag": "57343093-3dfe-4177-a21b-b9a847d0c3ec",
            "dataType": "int64",
            "modifiedTime": "2026-11-01T06:42:44.796667",
            "structureModifiedTime": "2026-11-01T06:42:44.766667"
          },
          {
            "name": "Free Games Ratio",
            "description": "Tỷ lệ game miễn phí trên toàn sàn",
            "expression": "DIVIDE([Total Free Games], [Total Games], 0)",
            "formatString": "0.0%",
            "displayFolder": "01. Market Overview",
            "lineageTag": "7021010e-cdd5-48fb-930c-227c392951b3",
            "dataType": "double",
            "modifiedTime": "2026-11-01T06:42:44.796667",
            "structureModifiedTime": "2026-11-01T06:42:44.766667"
          },
          {
            "name": "Vietnamese Supported Games",
            "description": "Số lượng game có hỗ trợ tiếng Việt",
            "expression": "CALCULATE([Total Games], dim_games[has_vietnamese] = 1)",
            "formatString": "#,##0",
            "displayFolder": "01. Market Overview",
            "lineageTag": "5bb181e1-f70e-41a4-a7d6-04b1b0c853d7",
            "dataType": "int64",
            "modifiedTime": "2026-11-01T06:42:44.796667",
            "structureModifiedTime": "2026-11-01T06:42:44.766667"
          },
          {
            "name": "Total Estimated Revenue",
            "description": "Tổng doanh thu gộp ước tính (USD)",
            "expression": "SUM(fact_game_metrics[estimated_revenue_avg_usd])",
            "formatString": "$#,##0",
            "displayFolder": "02. Financial Metrics",
            "lineageTag": "7092502f-5086-4a9a-ac31-7ac8ffe8eacc",
            "dataType": "double",
            "modifiedTime": "2026-11-01T06:42:44.796667",
            "structureModifiedTime": "2026-11-01T06:42:44.766667"
          },
          {
            "name": "Avg Game Price",
            "description": "Giá bán trung bình (USD)",
            "expression": "AVERAGE(fact_game_metrics[price_usd])",
            "formatString": "$#,##0.00",
            "displayFolder": "02. Financial Metrics",
            "lineageTag": "3fce6af6-a89e-43af-8c92-edc392ae9df1",
            "dataType": "double",
            "modifiedTime": "2026-11-01T06:42:44.796667",
            "structureModifiedTime": "2026-11-01T06:42:44.766667"
          },
          {
            "name": "Total Estimated Owners",
            "description": "Tổng lượng người sở hữu ước tính",
            "expression": "SUM(fact_game_metrics[estimated_owners_avg])",
            "formatString": "#,##0",
            "displayFolder": "02. Financial Metrics",
            "lineageTag": "bf906371-7611-4ea8-bb44-0f7a4b35a9a3",
            "dataType": "int64",
            "modifiedTime": "2026-11-01T06:42:44.796667",
            "structureModifiedTime": "2026-11-01T06:42:44.766667"
          },
          {
            "name": "Total Positive Reviews",
            "description": "Tổng số đánh giá tích cực",
            "expression": "SUM(fact_game_metrics[positive_reviews])",
            "formatString": "#,##0",
            "displayFolder": "03. Ratings & Sentiment",
            "lineageTag": "c15a1048-f4f0-4917-ae87-6932a4d37fe8",
            "dataType": "int64",
            "modifiedTime": "2026-11-01T06:42:44.796667",
            "structureModifiedTime": "2026-11-01T06:42:44.766667"
          },
          {
            "name": "Total Negative Reviews",
            "description": "Tổng số đánh giá tiêu cực",
            "expression": "SUM(fact_game_metrics[negative_reviews])",
            "formatString": "#,##0",
            "displayFolder": "03. Ratings & Sentiment",
            "lineageTag": "0e2d990b-c573-4781-a9d6-49f2a647710d",
            "dataType": "int64",
            "modifiedTime": "2026-11-01T06:42:44.796667",
            "structureModifiedTime": "2026-11-01T06:42:44.766667"
          },
          {
            "name": "Total Reviews",
            "description": "Tổng số lượt đánh giá",
            "expression": "SUM(fact_game_metrics[total_reviews])",
            "formatString": "#,##0",
            "displayFolder": "03. Ratings & Sentiment",
            "lineageTag": "4f7b198c-c116-4145-b5b9-b6da6e19e2de",
            "dataType": "int64",
            "modifiedTime": "2026-11-01T06:42:44.796667",
            "structureModifiedTime": "2026-11-01T06:42:44.766667"
          },
          {
            "name": "Platform Satisfaction Rate",
            "description": "Tỷ lệ đánh giá hài lòng chung (%)",
            "expression": "DIVIDE([Total Positive Reviews], [Total Reviews], 0)",
            "formatString": "0.0%",
            "displayFolder": "03. Ratings & Sentiment",
            "lineageTag": "64f8f7f1-cf30-4172-81c4-deda0c7a634f",
            "dataType": "double",
            "modifiedTime": "2026-11-01T06:42:44.796667",
            "structureModifiedTime": "2026-11-01T06:42:44.766667"
          },
          {
            "name": "Peak Concurrent Players (CCU)",
            "description": "Số người chơi đồng thời cao nhất (Peak CCU)",
            "expression": "MAX(fact_game_metrics[peak_ccu])",
            "formatString": "#,##0",
            "displayFolder": "04. Engagement",
            "lineageTag": "94b63204-96ec-432e-bd25-5924e4fe3ad9",
            "dataType": "int64",
            "modifiedTime": "2026-11-01T06:42:44.796667",
            "structureModifiedTime": "2026-11-01T06:42:44.766667"
          },
          {
            "name": "Avg Playtime (Hours)",
            "description": "Thời gian chơi trung bình toàn thời gian (Giờ)",
            "expression": "AVERAGE(fact_game_metrics[avg_playtime_forever_hours])",
            "formatString": "#,##0.00",
            "displayFolder": "04. Engagement",
            "lineageTag": "afc3909b-ee82-40f8-93e7-21e1defa839c",
            "dataType": "double",
            "modifiedTime": "2026-11-01T06:42:44.796667",
            "structureModifiedTime": "2026-11-01T06:42:44.766667"
          }
        ]
      }
