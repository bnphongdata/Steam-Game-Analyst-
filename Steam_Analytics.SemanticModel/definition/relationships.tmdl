relationship FactToDate
	fromColumn: fact_game_metrics.release_date_id
	toColumn: dim_date.date_id

relationship FactToGames
	crossFilteringBehavior: bothDirections
	fromCardinality: one
	fromColumn: fact_game_metrics.appid
	toColumn: dim_games.appid

relationship BridgeGenresToGames
	crossFilteringBehavior: bothDirections
	fromColumn: bridge_game_genres.appid
	toColumn: dim_games.appid

relationship BridgeGenresToGenres
	crossFilteringBehavior: bothDirections
	fromColumn: bridge_game_genres.genre_id
	toColumn: dim_genres.genre_id

