# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ipynb_checkpoints/

# Virtual Environments
venv/
.venv/
env/
ENV/

# Raw & Staging Data (Tải và xử lý tự động qua src/run_pipeline.py)
data/raw/*
!data/raw/.gitkeep
data/staging/*
!data/staging/.gitkeep

# CSV Data lớn (Tránh vượt giới hạn 100MB của GitHub, người dùng có thể xuất lại bằng pipeline)
data/processed/csv/*
!data/processed/csv/.gitkeep

# SQLite database file (>100MB, được tạo tự động bởi src/05_export_database.py)
data/processed/*.db
*.db-journal
*.db-wal

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
